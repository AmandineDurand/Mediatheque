{% import "component.html.twig" as component %}
{% set route_name = app.request.attributes.get('_route') %}

<nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container">
        <a href="{{ path('accueil') }}" class="navbar-brand">
            <img src="{{ asset('images/logo.png') }}" alt="logo">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                {{ component.nav_item('Documents', path('app_document_index'), '', 'app_document')}}
                {% if is_granted('ROLE_INSCRIT') %}
                    {{ component.nav_item('Favoris', path('app_favoris'), '', 'app_favoris')}}
                    {{ component.nav_item('Profil', path('app_profile'), '', 'app_profile')}}
                {% endif %}
                {% if is_granted('ROLE_ADHERENT') %}
                    {{ component.nav_item('Panier', path('voir_panier'), '', 'voir_panier')}}
                    {{ component.nav_item('Commandes', path('liste_commandes'), '', 'liste_commandes')}}
                {% endif %}
                {% if is_granted('ROLE_BIBLIOTHECAIRE') %}
                    {{ component.nav_item('Admin', path('app_admin_index'), '', 'app_admin_index')}}
                {% endif %}
                {{ component.nav_item('Contact', path('contact'), '', 'contact')}}
            </ul>
            <ul class="navbar-nav">
                {% if is_granted('ROLE_USER') %}
                    {{ component.nav_item(app.user.prenomUtil ~ ' ' ~ app.user.nomUtil, path('app_profile'))}}
                    {{ component.nav_item('Déconnexion', path('deconnexion'))}}
                {% else %}
                    {{ component.nav_item('Connexion', path('connexion'))}}
                    {{ component.nav_item('Inscription', path('inscription'))}}
                {% endif %}
            </ul>
        </div>
    </div>
</nav>