{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}

    <h1 class="h3 mb-3 mt-3 font-weight-normal">Nous contacter</h1>

    <section class="mb-3">
        <p class="mb-0">Téléphone : 04 67 34 87 00</p>
        <p>Email : <a href="mailto:contact@monsite.fr" class="text-dark text-decoration-none">contact@monsite.fr</a></p>
    </section>

    <section class="mb-3">
        <h2 class="h4" style="color: purple;">Disponibilités</h2>
        <p>
            Mardi au Samedi : 10h - 18h<br>
            Sauf vendredi : 14h - 18h<br>
            Nous sommes fermé les lundis, dimanches et jours fériés
        </p>
    </section>

    <section class="mb-3">
        <h2 class="h4" style="color: purple;">Réactivité</h2>
        <p>
            Nous répondons aux mails sous 48h, hors jours fermés. Si le délais est dépassé, n'hésitez pas à nous appeler
        </p>
    </section>

    <section class="mb-3">
        <h2 class="h4" style="color: purple;">Adresse</h2>
        <p>
            24 Rue de l'Acropole - 34000 Montpellier, France<br>
            N'hésitez pas à venir nous voir pendant les horaires d'ouvertures, nous serons ravi de répondre à vos questions
        </p>
    </section>

{% endblock %}
