<form method="post" action="{{ path('app_avis_delete', {'id': avisExist.id}) }}" onsubmit="return confirm('Êtes-vous sûr(e) de vouloir supprimer cet avis ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ avisExist.id) }}">
    <button class="btn btn-danger mb-3 btn-sm">Supprimer</button>
</form>
