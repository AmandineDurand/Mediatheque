{% extends 'base.html.twig' %}

{% block title %}{{ document.titreDoc }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-4">
            {# Placeholder image - change src as needed #}
            <img src="{{ document.url }}" alt="{{ document.titreDoc }}" class="img-fluid rounded shadow">
            <div class="d-flex justify-content-between mt-4">
                <a href="{{ path('app_document_index') }}" class="btn btn-secondary btn-sm">Retour</a>
                {% if is_granted('ROLE_INSCRIT') %}
                    {% if app.user.getDocumentsAimes().contains(document) %}
                        <a href="{{ path('app_toggle_favori', {'id': document.id}) }}" class="btn btn-outline-success btn-sm">Ne plus aimer</a>
                    {% else %}
                        <a href="{{ path('app_toggle_favori', {'id': document.id}) }}" class="btn btn-success btn-sm">Aimer</a>
                    {% endif %}
                {% endif %}
                {% if is_granted('ROLE_ADHERENT') %}
                    {% if document.stockDoc == 0 %}
                        <a class="btn btn-light btn-sm">Indisponible</a>
                    {% else %}
                        {% if panier and document in panier.documents %}
                            <a href="{{ path('enlever_du_panier', {'id': document.id}) }}" class="btn btn-outline-primary btn-sm">Enlever du panier</a>
                        {% else %}
                            <a href="{{ path('document_emprunter', {'id': document.id}) }}" class="btn btn-primary btn-sm">Emprunter</a>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </div>
            {% if is_granted('ROLE_BIBLIOTHECAIRE') %}
                <div class="d-flex justify-content-between mt-2">
                    <a href="{{ path('app_document_edit', {'id': document.id}) }}" class="btn btn-warning btn-sm mb-3">Modifier</a>
                    {{ include('document/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>
        <div class="col-md-8">
            <h1 class="display-4 mb-3">{{ document.titreDoc }}</h1>
            {% if document.stockDoc <=3 and document.stockDoc >1 %}
                <div class="alert alert-info py-2">
                    Plus que {{ document.stockDoc }} exemplaires
                </div>
            {% elseif document.stockDoc == 1 %}
                <div class="alert alert-info py-2">
                    Plus que {{ document.stockDoc }} exemplaire
                </div>
            {% endif %}
            <ul class="list-group list-group-flush mt-3">
                <li class="list-group-item"><strong>Année de sortie : </strong> {{ document.anneeSortie ? document.anneeSortie|date('Y') : 'N/A' }}</li>
                <li class="list-group-item"><strong>Auteur : </strong>
                    {% if document.auteur == NULL %}
                        inconnu
                    {% else %}
                        {{ document.auteur.nomAut }}
                    {% endif %}
                </li>
                <li class="list-group-item">
                    {% if document.categories is not empty %}
                        <div class="d-flex flex-wrap gap-2">
                            {% for categorie in document.categories %}
                                <a class="btn btn-primary btn-sm mb-1">
                                    {{ categorie.nom }}
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </li>
                <li class="list-group-item"><strong>Type : </strong> {{ type }}</li>

                {% if type == 'livre' %}
                    <li class="list-group-item"><strong>ISBN : </strong> {{ document.ISBN }}</li>
                    <li class="list-group-item"><strong>Nombre de pages : </strong> {{ document.nbPages }}</li>
                {% elseif type == 'periodique' %}
                    <li class="list-group-item"><strong>Fréquence : </strong> {{ document.frequence.toString() }}</li>
                    <li class="list-group-item"><strong>Numéro : </strong> {{ document.numero }}</li>
                {% elseif type == 'sonore' %}
                    <li class="list-group-item"><strong>Durée : </strong> {{ document.dureeSon }} min</li>
                    <li class="list-group-item"><strong>Format : </strong> {{ document.formatSon.toString() }}</li>
                {% elseif type == 'video' %}
                    <li class="list-group-item"><strong>Durée : </strong> {{ document.dureeVid }} min</li>
                    <li class="list-group-item"><strong>Format : </strong> {{ document.formatVid.toString() }}</li>
                {% endif %}

                <li class="list-group-item"><strong>Résumé : </strong> {{ document.resumeDoc }}</li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}

