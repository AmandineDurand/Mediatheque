{{ form_start(form, {'attr': {'class': 'container mt-3', id: 'new-doc-form'}}) }}
    <h2 class="h3 mb-3 mt-3 font-weight-normal">Créer un nouveau document</h2>
    
    {{ form_errors(form) }}

    <div class="row mb-3">
        <div class="col-md-6">
            {{ form_row(form.titreDoc, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.anneeSortie, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="mb-3">
        {{ form_row(form.url, {'attr': {'class': 'form-control'}}) }}
    </div>
    <div class="mb-3">
        {{ form_row(form.resumeDoc, {'attr': {'class': 'form-control'}}) }}
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            {{ form_row(form.stockDoc, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.auteur, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>

    <div class="mb-3">
        {{ form_row(form.categories, {'attr': {'class': 'form-control'}}) }}
    </div>

    <div class="mb-3">
        {{ form_row(form.type, {'attr': {'class': 'form-control', 'id': 'document_type'}}) }}
    </div>

    <div id="subforms">
        <div id="subform-livre" class="subform subform-livre">
            {% if form.ISBN is defined %}
                <h4 class="mt-3">Livre</h4>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.ISBN, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.nbPages, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            {% endif %}
        </div>

        <div id="subform-periodique" class="subform subform-periodique">
            {% if form.frequence is defined %}
                <h4 class="mt-3">Périodique</h4>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.frequence, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.numero, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            {% endif %}
        </div>

        <div id="subform-sonore" class="subform subform-sonore">
            {% if form.dureeSon is defined %}
                <h4 class="mt-3">Document sonore</h4>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.dureeSon, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.formatSon, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            {% endif %}
        </div>

        <div id="subform-video" class="subform subform-video">
            {% if form.dureeVid is defined %}
                <h4 class="mt-3">Document vidéo</h4>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.dureeVid, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.formatVid, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{{ form_end(form) }}

