<form method="post" action="{{ path('app_admin_abonnement_delete', {'id': abonnement.id}) }}" onsubmit="return confirm('Êtes-vous sûr(e) de vouloir supprimer cet abonnement ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ abonnement.id) }}">
    <button class="btn btn-danger mb-3 btn-sm">Supprimer</button>
</form>
