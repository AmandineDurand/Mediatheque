<form method="post" action="{{ path('app_admin_notification_delete', {'id': notif.id}) }}" onsubmit="return confirm('Êtes-vous sûr(e) de vouloir supprimer cette notification ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ notif.id) }}">
    <button class="btn btn-danger mb-3 btn-sm">Supprimer</button>
</form>
