{% extends 'base_admin.html.twig' %}

{% block title_admin %}Les notifications{% endblock %}

{% block admin_content %}
    <div class="row">
        <div class="col">
            <h1 class="h3 mb-3 mt-3 font-weight-normal">Liste des notifications</h1>
        </div>
        <div class="col text-end mx-2">
            <a href="{{ path('app_admin_notification_new') }}" class="btn btn-primary mt-3">Nouvelle</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Objet</th>
                    <th scope="col">Contenu</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for notif in notifications %}
                    <tr>
                        <td>{{ notif.id }}</td>
                        <td>{{ notif.objetNotif }}</td>
                        <td>{{ notif.contenuNotif }}</td>
                        <td style="width: 25%;">
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="{{ path('app_admin_notification_edit', {'id': notif.id}) }}" class="btn btn-sm btn-warning mb-3">Modifier</a>
                                {{ include('admin/notification/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
