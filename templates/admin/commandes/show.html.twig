{% extends 'base_admin.html.twig' %}

{% block title_admin %}Commande #{{ commande.id }}{% endblock %}

{% block admin_content %}
<div class="container mt-4">
    <h1 class="mb-4">Détail de la commande #{{ commande.id }}</h1>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Informations de la commande</h5>
            <p class="mt-3 mb-0"><strong>ID : </strong>{{ commande.id }}</p>
            <p class="mt-1 mb-0"><strong>Date de commande : </strong>{{ commande.dateCom ? commande.dateCom|date('d/m/Y') : 'Non validée' }}</p>
            <p class="mt-1 mb-0"><strong>Date de retrait : </strong>{{ commande.dateRetrait ? commande.dateRetrait|date('d/m/Y') : 'Non retirée' }}</p>
            <p class="my-1"><strong>Date de rendu : </strong>{{ commande.dateRendu ? commande.dateRendu|date('d/m/Y') : 'Non rendu' }}</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Documents de la commande</h5>

            {% if commande.documents|length > 0 %}
                <table class="table table-striped table-hover mt-3">
                    <thead class="table-light">
                        <tr>
                            <th>Titre</th>
                            <th>Sortie</th>
                            <th>Auteur</th>
                            <th>Résumé</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for document in commande.documents %}
                        <tr>
                            <td>{{ document.titreDoc }}</td>
                            <td>{{ document.anneeSortie ? document.anneeSortie|date('Y') : 'N/A' }}</td>
                            <td>
                                {% if document.auteur == NULL %}
                                    <p class="card-text mb-2">inconnu</p>
                                {% else %}
                                    <p class="card-text mb-2">{{ document.auteur.nomAut }}</p>
                                {% endif %}
                            </td>
                            <td>{{ document.resumeDoc|length > 50 ? document.resumeDoc|slice(0, 50) ~ '…' : document.resumeDoc }}</td>
                            <td><a href="{{ path('app_document_show', {'id': document.id}) }}" class="btn btn-info btn-sm">Voir</a></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="alert alert-info mt-3">
                    Aucun document dans cette commande.
                </div>
            {% endif %}
        </div>
    </div>

    {% if contentieuxList is not empty %}
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Contentieux associé</h5>
                <table class="table table-striped table-hover mt-3">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Type</th>
                            <th scope="col">Date</th>
                            <th scope="col">Nombre de Documents</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for contentieux in contentieuxList %}
                            <tr>
                                <td>{{ contentieux.id }}</td>
                                <td>{{ contentieux.typeCont.toString() }}</td>
                                <td>{{ contentieux.dateCont|date('d/m/Y') }}</td>
                                <td>{{ contentieux.nbDoc }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info py-2">
            Aucun contentieux associé à cette commande.
        </div>
    {% endif %}

    <div class="d-flex gap-2">
        <a href="{{ path('admin_commandes') }}" class="btn btn-secondary btn-sm mb-3">Retour à la liste</a>
    </div>
</div>
{% endblock %}
