{% extends 'base_admin.html.twig' %}

{% block title_admin %}Nouveau contentieux{% endblock %}

{% block admin_content %}
    <h1 class="h3 mb-3 mt-3 font-weight-normal">Créer un contentieux</h1>

    {{ include('admin/contentieux/_form.html.twig') }}

    <div class="row my-3">
        <div class="col-md-2">
            <button type="submit" form="contentieux-form" class="btn btn-primary">Enregister</button>
        </div>
        <div class="col-md-2">
            <a class="btn btn-secondary" href="{{ path('admin_commandes') }}">Retour</a>
        </div>
    </div>
{% endblock %}
