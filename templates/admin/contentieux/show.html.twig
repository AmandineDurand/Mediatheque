{% extends 'base.html.twig' %}

{% block title %}Contentieux{% endblock %}

{% block body %}
    <h1>Contentieux</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ contentieux.id }}</td>
            </tr>
            <tr>
                <th>DateCont</th>
                <td>{{ contentieux.dateCont ? contentieux.dateCont|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>TypeCont</th>
                <td>{{ contentieux.typeCont }}</td>
            </tr>
            <tr>
                <th>NbDoc</th>
                <td>{{ contentieux.nbDoc }}</td>
            </tr>
            <tr>
                <th>InfosCont</th>
                <td>{{ contentieux.infosCont }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_contentieux_index') }}">back to list</a>

    <a href="{{ path('app_contentieux_edit', {'id': contentieux.id}) }}">edit</a>

    {{ include('contentieux/_delete_form.html.twig') }}
{% endblock %}
