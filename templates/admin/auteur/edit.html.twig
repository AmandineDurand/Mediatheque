{% extends 'base_admin.html.twig' %}

{% block title_admin %}Modifier l'auteur{% endblock %}

{% block admin_content %}
    <h1 class="h3 mb-3 mt-3 font-weight-normal">Modifier l'auteur</h1>

    {{ include('admin/auteur/_form.html.twig') }}

    <div class="row my-3">
        <div class="col-md-2">
            <button type="submit" form="new-aut-form" class="btn btn-sm btn-primary mb-3">Enregistrer</button>
        </div>
        <div class="col-md-2">
            <a class="btn btn-sm btn-secondary mb-3" href="{{ path('app_admin_auteur_index') }}">Retour</a>
        </div>
        <div class="col-md-2">
            {{ include('admin/auteur/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
