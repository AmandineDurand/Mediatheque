{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm rounded p-4">
        <h1 class="h3 mb-3 mt-1 font-weight-normal">✏️ Modifier mes informations</h1>

        {{ include('profile/_form.html.twig') }}

        <div class="mt-3 d-flex justify-content-between">
            <button type="submit" form="edit-user-form" class="btn btn-primary">💾 Modifier</button>
            <a class="btn btn-secondary" href="{{ path('app_profile') }}">↩️ Annuler</a>
        </div>
    </div>
</div>
{% endblock %}
